#!/usr/bin/env python3
"""Pre-render one audio clip per kana reading into KatakanaWidget/data/audio/.

Why clips instead of live TTS: every runtime engine tested (Piper, espeak-ng,
Open JTalk) falls apart on a single mora. Piper's sentence-trained voice gives a
different length every call, chops the vowel, and renders ン as a click; a
recogniser identified 5 of 104 kana. Microsoft's neural voice via edge-tts is
the only one that says an isolated kana cleanly, so it is rendered once here and
the widget just plays the file.

    python3 -m venv .venv && .venv/bin/pip install edge-tts numpy
    .venv/bin/python gen-audio            # all readings (network needed)
    .venv/bin/python gen-audio ka shi n   # just these
    .venv/bin/python gen-audio --voice ja-JP-KeitaNeural   # male voice

Needs ffmpeg on PATH to decode edge-tts's mp3. One file per romaji reading, so
hiragana and katakana share clips and ジ/ヂ, ズ/ヅ (same sound) share too.
Clips are trimmed, peak-normalised to the same level and padded, so every kana
plays at the same loudness with a short lead-in and no clipped vowel.
"""

import argparse
import asyncio
import json
import subprocess
import sys
import wave
from pathlib import Path

import numpy as np

HERE = Path(__file__).resolve().parent
DATA = HERE / "KatakanaWidget" / "data"
OUT = DATA / "audio"
RATE = 22050
PEAK = 0.7          # -3 dBFS, identical for every clip
THRESHOLD = 0.02    # amplitude that counts as speech when trimming
LEAD_MS, TAIL_MS = 60, 200


def render(text: str, voice: str) -> np.ndarray:
    import edge_tts

    mp3 = OUT / ".tmp.mp3"
    asyncio.run(edge_tts.Communicate(text, voice).save(str(mp3)))
    pcm = subprocess.run(
        ["ffmpeg", "-loglevel", "error", "-i", str(mp3), "-f", "s16le", "-ac", "1", "-ar", str(RATE), "-"],
        check=True, capture_output=True,
    ).stdout
    mp3.unlink()
    return np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768


def tidy(a: np.ndarray) -> np.ndarray:
    loud = np.where(np.abs(a) > THRESHOLD)[0]
    if len(loud) == 0:
        raise RuntimeError("clip is silent")
    a = a[loud[0]:loud[-1] + 1]
    a = a * (PEAK / np.abs(a).max())
    # short fades so the cut edges do not click
    n = min(len(a) // 4, RATE // 100)
    a[:n] *= np.linspace(0, 1, n)
    a[-n:] *= np.linspace(1, 0, n)
    lead = np.zeros(RATE * LEAD_MS // 1000, dtype=np.float32)
    tail = np.zeros(RATE * TAIL_MS // 1000, dtype=np.float32)
    return np.concatenate([lead, a, tail])


def write(path: Path, a: np.ndarray) -> None:
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes((np.clip(a, -1, 1) * 32767).astype(np.int16).tobytes())


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("readings", nargs="*", help="romaji readings to (re)render; default: all")
    ap.add_argument("--voice", default="ja-JP-NanamiNeural", help="edge-tts voice (edge-tts --list-voices | grep ja-JP)")
    args = ap.parse_args()

    kana = json.loads((DATA / "kana.json").read_text())
    # katakana spelling as the source text; the reading is the file name
    by_reading = {}
    for k in sorted(kana, key=lambda k: k["set"] != "katakana"):   # katakana first
        by_reading.setdefault(k["romaji"], k["kana"])
    wanted = args.readings or sorted(by_reading)
    unknown = [r for r in wanted if r not in by_reading]
    if unknown:
        sys.exit(f"not in kana.json: {' '.join(unknown)}")

    OUT.mkdir(parents=True, exist_ok=True)
    for reading in wanted:
        text = by_reading[reading]
        a = tidy(render(text, args.voice))
        write(OUT / f"{reading}.wav", a)
        print(f"{text}\t{reading}.wav\t{len(a) / RATE:.2f}s")
    return 0


if __name__ == "__main__":
    sys.exit(main())
